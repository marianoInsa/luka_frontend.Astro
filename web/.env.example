# web/ — variables de F0/F1 (subconjunto).
# Lista completa en docs/migracion-astro/00-plan-limpieza-preparacion.md §7.
APP_ENV=development
APP_BASE_URL=http://localhost:4321
AUTH_COOKIE_SECURE=false
SUPABASE_URL=https://your-project.supabase.co
DATABASE_URL=postgres://user:password@host:6543/postgres

# Las variables PUBLIC_* se exponen al navegador por diseño (la publishable key
# es pública). Los secretos server-only (SECRET_KEY, DATABASE_URL,
# FLOW_ADMIN_API_KEY) no son parte de esta fase y NUNCA deben usar PUBLIC_.
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
