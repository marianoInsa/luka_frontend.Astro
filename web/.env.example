# web/ — variables de entorno (detalle en README.md)
APP_ENV=development
APP_BASE_URL=http://localhost:4321
AUTH_COOKIE_SECURE=false
SECRET_KEY=change-me-to-a-random-secret-in-production
DATABASE_URL=postgres://user:password@host:6543/postgres
SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Panel de flujos (F4): secretos solo server-side, nunca PUBLIC_.
LUKA_BACKEND_URL=http://localhost:8000
FLOW_ADMIN_API_KEY=replace-with-the-same-long-random-value-as-luka
FLOW_ADMIN_AUTH_USER_IDS=00000000-0000-0000-0000-000000000001
