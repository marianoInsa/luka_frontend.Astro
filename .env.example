APP_ENV=development
APP_BASE_URL=http://localhost:8000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
AUTH_COOKIE_SECURE=false
ENABLE_MOCK_AUTH=true

# Application secrets and local dashboard data
SECRET_KEY=change-me-to-a-random-secret-in-production
# Used only by /dev-login (requires ENABLE_MOCK_AUTH=true) to seed a fake
# session — the linked Usuario row for this id must exist for the dashboard
# to actually show data locally.
MOCK_AUTH_USER_ID=00000000-0000-0000-0000-000000000001

# Supabase / PostgreSQL
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.wewtbqfbnymyvvxzrmbg.supabase.co:6543/postgres

# Panel de flujos: la clave queda sólo en el servidor de luka_frontend.
LUKA_BACKEND_URL=http://localhost:8000
FLOW_ADMIN_API_KEY=replace-with-the-same-long-random-value-as-luka
FLOW_ADMIN_AUTH_USER_IDS=00000000-0000-0000-0000-000000000001

# Migración a Astro (F1): ASTRO_ORIGIN es el servicio de web/ (Astro) y
# ASTRO_MIGRATED_PATHS lista los paths que sirve Astro; el resto queda en FastAPI.
# La lista debe incluir los assets de la landing (CSS construido en /_astro,
# archivos de public/ y robots/sitemap): sin ellos la landing responde 200 pero
# sus assets dan 404. Con la lista vacía el facade es no-op.
ASTRO_ORIGIN=http://localhost:4321
ASTRO_MIGRATED_PATHS=/,/_astro,/robots.txt,/sitemap.xml,/favicon.svg,/favicon-32.png,/favicon-512.png,/apple-touch-icon.png,/logo-luka.svg,/logo-luka-claro.svg,/logo-luka-oscuro.svg,/logo-luka-mono.svg

# Para probar la topología F1 en local usá el build de Astro, no el dev server:
#   cd web && npm run build && node dist/server/entry.mjs
# El dev server referencia URLs de Vite (/@vite, /src/...) que el facade no proxya.