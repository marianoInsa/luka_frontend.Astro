---
import iconActivity from './icons/icon_activity.svg?raw';
import iconAlert from './icons/icon_alert.svg?raw';
import iconArrowUpRight from './icons/icon_arrow_up_right.svg?raw';
import iconBarChart from './icons/icon_bar_chart.svg?raw';
import iconComingSoon from './icons/icon_coming_soon.svg?raw';
import iconDevMode from './icons/icon_dev_mode.svg?raw';
import iconDollar from './icons/icon_dollar.svg?raw';
import iconEmptyInbox from './icons/icon_empty_inbox.svg?raw';
import iconHistoryNav from './icons/icon_history_nav.svg?raw';
import iconHistoryStats from './icons/icon_history_stats.svg?raw';
import iconLogoutMobile from './icons/icon_logout_mobile.svg?raw';
import iconLogoutSidebar from './icons/icon_logout_sidebar.svg?raw';
import iconNavDashboard from './icons/icon_nav_dashboard.svg?raw';
import iconPieChart from './icons/icon_pie_chart.svg?raw';
import iconPlaceholder from './icons/icon_placeholder.svg?raw';
import iconPortfolio from './icons/icon_portfolio.svg?raw';
import iconStreak from './icons/icon_streak.svg?raw';
import iconTagList from './icons/icon_tag_list.svg?raw';
import iconTagStats from './icons/icon_tag_stats.svg?raw';
import iconTrendUp from './icons/icon_trend_up.svg?raw';
import iconUserAvatar from './icons/icon_user_avatar.svg?raw';
import logoLogin from './icons/logo_login.svg?raw';
import logoSidebar from './icons/logo_sidebar.svg?raw';

// Copia local de los SVG de Jinja (app/templates/components/icons).
const ICONS = {
  icon_activity: iconActivity,
  icon_alert: iconAlert,
  icon_arrow_up_right: iconArrowUpRight,
  icon_bar_chart: iconBarChart,
  icon_coming_soon: iconComingSoon,
  icon_dev_mode: iconDevMode,
  icon_dollar: iconDollar,
  icon_empty_inbox: iconEmptyInbox,
  icon_history_nav: iconHistoryNav,
  icon_history_stats: iconHistoryStats,
  icon_logout_mobile: iconLogoutMobile,
  icon_logout_sidebar: iconLogoutSidebar,
  icon_nav_dashboard: iconNavDashboard,
  icon_pie_chart: iconPieChart,
  icon_placeholder: iconPlaceholder,
  icon_portfolio: iconPortfolio,
  icon_streak: iconStreak,
  icon_tag_list: iconTagList,
  icon_tag_stats: iconTagStats,
  icon_trend_up: iconTrendUp,
  icon_user_avatar: iconUserAvatar,
  logo_login: logoLogin,
  logo_sidebar: logoSidebar,
} as const;

interface Props {
  name: keyof typeof ICONS;
  label?: string;
}

const { name, label } = Astro.props;
---

{
  label ? (
    <span role="img" aria-label={label}>
      <Fragment set:html={ICONS[name]} />
    </span>
  ) : (
    <span aria-hidden="true">
      <Fragment set:html={ICONS[name]} />
    </span>
  )
}
