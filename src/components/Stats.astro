---
import type { ConsumoPresupuesto, PatrimonioNeto, SummaryStats } from '../lib/dashboard';
import { formatDecimals, formatInt } from '../lib/format';
import { formatQuoteTime, type QuoteType } from '../lib/quotes';
import Icon from './Icon.astro';

interface Props {
  stats: SummaryStats;
  patrimonio: PatrimonioNeto;
  consumo: ConsumoPresupuesto;
}

const { stats, patrimonio, consumo } = Astro.props;

const TIPOS: QuoteType[] = ['oficial', 'mep', 'blue'];
const TIPO_LABELS: Record<QuoteType, string> = { oficial: 'Oficial', mep: 'MEP', blue: 'Blue' };

const hasBudget = consumo.limit > 0;
const hasTopCategory = stats.top_category !== '—';
// Signo antes del prefijo de moneda: -$500, -u$s500,00.
const money = (prefix: string, text: string): string =>
  text.startsWith('-') ? `-${prefix}${text.slice(1)}` : `${prefix}${text}`;
const capitalColor =
  patrimonio.ars_total > 0 || patrimonio.usd_total > 0
    ? 'var(--money-in)'
    : patrimonio.ars_total < 0 && patrimonio.usd_total < 0
      ? 'var(--money-out)'
      : 'var(--text-primary)';

const quoteRows = TIPOS.flatMap((tipo) => {
  const quote = patrimonio.quotes[tipo];
  return quote ? [{ tipo, quote }] : [];
});

// Evita romper el render si el backend manda una fecha que no parsea.
const quoteTime = (iso: string | undefined): string | null => {
  if (!iso || Number.isNaN(new Date(iso).getTime())) return null;
  return formatQuoteTime(iso).replace(',', '');
};
const consultedAt = quoteTime(
  quoteRows
    .map(({ quote }) => quote.fetched_at)
    .sort()
    .at(-1),
);
const asOf = quoteTime(
  quoteRows
    .map(({ quote }) => quote.as_of)
    .sort()
    .at(-1),
);
const staleTitle = (iso: string): string => {
  const time = quoteTime(iso);
  return time ? `Cotización de ${time}` : 'Cotización desactualizada';
};

const consumoColor = !hasBudget
  ? 'var(--money-out)'
  : consumo.over
    ? 'var(--danger)'
    : consumo.pct > 80
      ? 'var(--warning)'
      : 'var(--action)';
const consumoOver = consumo.over === true;
---

<div class="stats-grid">

  <!-- KPI 1: Capital consolidado -->
  <div class="stat-card stat-card--highlight stat-card--capital" id="stat-patrimonio">
    <div class="stat-icon" style="--icon-color: var(--action);">
      <Icon name="icon_trend_up" />
    </div>
    <div class="stat-body stat-body--full">
      <p class="stat-label">Capital consolidado</p>
      <div class="capital-lines">
        <span class="capital-line" style={`color: ${capitalColor};`}>
          {money('$', formatInt(patrimonio.ars_total))}
        </span>
        <span class="capital-line" style={`color: ${capitalColor};`}>
          {money('u$s', formatDecimals(patrimonio.usd_total, 2))}
        </span>
      </div>
      <ul class="capital-totals">
        {TIPOS.map((tipo) => {
          const total = patrimonio.totals[tipo];
          const quote = patrimonio.quotes[tipo];
          return (
            <li class="capital-total">
              <span class="capital-total__label">{TIPO_LABELS[tipo]}</span>
              <span class="capital-total__value" title={total == null ? 'No disponible' : undefined}>
                {total == null ? 'n/d' : money('$', formatInt(total))}
              </span>
              {quote?.stale && (
                <span class="stat-badge stat-badge--warning" title={staleTitle(quote.fetched_at)}>
                  Desactualizada
                </span>
              )}
            </li>
          );
        })}
      </ul>
      <p class="stat-hint">Saldos originales, sin vender. Valuado a compra.</p>
    </div>
  </div>

  <!-- KPI 2: Cotizaciones -->
  <div class="stat-card" id="stat-cotizacion">
    <div class="stat-icon" style="--icon-color: var(--success);">
      <Icon name="icon_dollar" />
    </div>
    <div class="stat-body stat-body--full">
      <p class="stat-label">Cotizaciones</p>
      {
        <>
          {quoteRows.length === 0 && (
            <p class="stat-hint">Cotizaciones no disponibles; no se convierte.</p>
          )}
          <table class="quotes-table">
            <thead>
              <tr>
                <th scope="col">Casa</th>
                <th scope="col">Compra</th>
                <th scope="col">Venta</th>
              </tr>
            </thead>
            <tbody>
              {TIPOS.map((tipo) => {
                const quote = patrimonio.quotes[tipo];
                return (
                  <tr>
                    <th scope="row">
                      <span class="quotes-house">
                        {TIPO_LABELS[tipo]}
                        {quote?.stale && (
                          <span
                            class="stat-badge stat-badge--warning"
                            title={staleTitle(quote.fetched_at)}
                          >
                            Desactualizada
                          </span>
                        )}
                      </span>
                    </th>
                    <td>{quote?.compra == null ? 'n/d' : `$${formatDecimals(quote.compra)}`}</td>
                    <td>{quote?.venta == null ? 'n/d' : `$${formatDecimals(quote.venta)}`}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
          {patrimonio.usd_total === 0 && <p class="quotes-note">Sin saldos en USD.</p>}
          {asOf && <p class="quotes-asof">Actualizada {asOf}</p>}
          <p class="quotes-footnote">
            DolarAPI{consultedAt ? `, consultado ${consultedAt}` : ''}. Valuado a compra.
          </p>
        </>
      }
    </div>
  </div>

  <!-- KPI 3: Consumo de Presupuesto -->
  <div class="stat-card" id="stat-consumo">
    <div class="stat-icon" style={`--icon-color: ${consumoColor};`}>
      <Icon name="icon_history_stats" />
    </div>
    <div class="stat-body stat-body--full">
      <div class="stat-row">
        <p class="stat-label">Presupuesto</p>
        <p class:list={['stat-value', !hasBudget && 'stat-value--muted']}>
          {hasBudget ? `${consumo.pct}%` : 'Sin datos'}
        </p>
      </div>
      <div class="kpi-bar-bg">
        <div
          class:list={['kpi-bar-fill', consumoOver && 'kpi-bar--over', !consumoOver && consumo.pct > 80 && 'kpi-bar--warn']}
          style={`width: ${hasBudget ? consumo.pct : 0}%`}
        >
        </div>
      </div>
      <p class="stat-hint">
        {
          hasBudget ? (
            <>
              ${formatInt(consumo.spent)} / ${formatInt(consumo.limit)}
              {consumoOver && <span class="stat-badge stat-badge--danger">Excedido</span>}
            </>
          ) : (
            <>
              Sin presupuesto
              <span class="stat-badge stat-badge--soon">Próximamente</span>
            </>
          )
        }
      </p>
    </div>
  </div>

  <!-- KPI 4: Días de Racha -->
  <div class="stat-card stat-card--placeholder" id="stat-racha">
    <div class="stat-icon" style="--icon-color: var(--warning);">
      <Icon name="icon_streak" />
    </div>
    <div class="stat-body">
      <p class="stat-label">Días de racha</p>
      <p class="stat-value stat-value--muted">Sin datos</p>
      <p class="stat-hint"><span class="stat-badge stat-badge--soon">Próximamente</span></p>
    </div>
  </div>

  <!-- KPI 6: Categoría Top -->
  <div class:list={['stat-card', !hasTopCategory && 'stat-card--placeholder']} id="stat-category">
    <div class="stat-icon" style={`--icon-color: ${hasTopCategory ? 'var(--cat-ocio)' : 'var(--money-out)'};`}>
      <Icon name="icon_tag_stats" />
    </div>
    <div class="stat-body">
      <p class="stat-label">Categoría top</p>
      <p class:list={['stat-value', !hasTopCategory && 'stat-value--muted']}>
        {hasTopCategory ? stats.top_category : 'Sin datos'}
      </p>
      {!hasTopCategory && (
        <p class="stat-hint"><span class="stat-badge stat-badge--soon">Próximamente</span></p>
      )}
    </div>
  </div>

</div>
