---
import type { FlowSummary } from '../lib/flow-admin';

// Port de app/templates/admin_flows.html (bloque content).
interface Props {
  flows: FlowSummary[];
  error?: string | null;
}

const { flows, error = null } = Astro.props;
---

<section class="flow-admin-shell">
  <header class="page-header flow-admin-header">
    <div>
      <p class="eyebrow">Administración</p>
      <h1 class="page-title">Flujos conversacionales</h1>
      <p class="page-subtitle">
        Editá cómo Luka presenta mensajes y recorridos, sin cambiar sus reglas financieras.
      </p>
    </div>
    <a class="flow-button flow-button-primary" href="/admin/flujos/nuevo">Crear flujo</a>
  </header>

  <div class="flow-safety-note">
    <strong>Routing libre siempre activo.</strong>
    Los flujos personalizan respuestas emitidas por el backend; no crean menús globales ni impiden
    que el usuario haga otra operación.
  </div>

  {
    error ? (
      <div class="flow-alert flow-alert-error" role="alert">
        <strong>No pudimos cargar los flujos.</strong>
        <span>{error}</span>
      </div>
    ) : flows.length === 0 ? (
      <div class="flow-empty">
        <span class="flow-empty-mark">01</span>
        <h2>Todavía no hay flujos configurados</h2>
        <p>Creá el primero para personalizar una respuesta que Luka ya sabe cuándo emitir.</p>
        <a class="flow-button flow-button-primary" href="/admin/flujos/nuevo">
          Crear primer flujo
        </a>
      </div>
    ) : (
      <>
      <form class="flow-list-filters" id="flow-list-filters" role="search" aria-label="Buscar flujos">
        <label class="flow-field"><span>Buscar por nombre o ID</span><input type="search" id="flow-search" placeholder="Nombre, identificador o ID del flujo" autocomplete="off" aria-controls="flow-list" /></label>
        <label class="flow-field"><span>Estado</span><select id="flow-status-filter" aria-controls="flow-list"><option value="all">Todos</option><option value="active">Solo activos</option><option value="archived">Solo retirados</option></select></label>
        <button type="reset" class="flow-button flow-button-secondary">Limpiar filtros</button>
      </form>
      <p class="flow-list-count" id="flow-list-count" role="status" aria-live="polite">{flows.length} flujos</p>
      <div class="flow-empty" id="flow-list-empty" hidden><h2>No hay flujos que coincidan</h2><p>Probá con otro nombre o ID, cambiá el estado o limpiá los filtros.</p></div>
      <div class="flow-grid" id="flow-list">
        {flows.map((flow) => (
          <article class="flow-card" data-flow-status={flow.status} data-flow-search={`${flow.name} ${flow.id} ${flow.slug} ${flow.event_key}`}>
            <div class="flow-card-topline">
              <span class:list={['flow-status', `flow-status-${flow.status}`]}>
                {flow.status === 'active' ? 'Activo' : 'Retirado'}
              </span>
              <code>{flow.event_key}</code>
            </div>
            <div class="flow-card-body">
              <h2>{flow.name}</h2>
              <p class="flow-slug">{flow.slug}</p>
            </div>
            <div class="flow-version-row">
              <div>
                <span class="flow-meta-label">Publicada</span>
                <strong>{flow.published ? `v${flow.published.version_number}` : '—'}</strong>
              </div>
              <div>
                <span class="flow-meta-label">Borrador</span>
                <strong>{flow.draft ? `v${flow.draft.version_number}` : '—'}</strong>
              </div>
              <a class="flow-card-link" href={`/admin/flujos/${flow.id}`}>Abrir editor →</a>
            </div>
          </article>
        ))}
      </div>
      </>
    )
  }
</section>

<script>import '../scripts/admin-flow-list';</script>
