---
import Icon from './Icon.astro';
---

<!-- Gráfico 1: Distribución por Categorías (Anillo) -->
<div class="section-card chart-card" id="card-pie">
  <h2 class="section-title">
    <Icon name="icon_pie_chart" />
    Egresos por categoría
  </h2>
  <div class="chart-wrapper" data-loading="true" aria-busy="true">
    <div class="chart-skeleton" aria-hidden="true">
      <div class="skeleton" style="height:100%"></div>
    </div>
    <canvas id="chart-pie" aria-label="Gráfico de egresos por categoría" role="img"></canvas>
  </div>
</div>

<!-- Gráfico 2: Composición Multidivisa (Barras Apiladas ARS vs USD) -->
<div class="section-card chart-card" id="card-portfolio">
  <h2 class="section-title">
    <Icon name="icon_bar_chart" />
    Egresos
  </h2>
  <div class="chart-wrapper" data-loading="true" aria-busy="true">
    <div class="chart-skeleton" aria-hidden="true">
      <div class="skeleton" style="height:100%"></div>
    </div>
    <canvas id="chart-portfolio" aria-label="Egresos por mes y moneda" role="img"></canvas>
  </div>
</div>

<!-- Gráfico 3: Flujo Ingresos vs Egresos (Barras Agrupadas) -->
<div class="section-card chart-card chart-card--wide" id="card-flow">
  <h2 class="section-title">
    <Icon name="icon_activity" />
    Flujo mensual — Ingresos vs Egresos
  </h2>
  <div class="chart-wrapper chart-wrapper--tall" data-loading="true" aria-busy="true">
    <div class="chart-skeleton" aria-hidden="true">
      <div class="skeleton" style="height:100%"></div>
    </div>
    <canvas id="chart-flow" aria-label="Flujo mensual de ingresos y egresos" role="img"></canvas>
  </div>
</div>
