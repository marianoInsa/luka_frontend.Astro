---
import type { RecentTransaction } from '../lib/dashboard';
import { formatDecimals } from '../lib/format';
import Icon from './Icon.astro';

interface Props {
  transactions: RecentTransaction[];
}

const { transactions } = Astro.props;
---

{
  transactions.length > 0 ? (
    <div class="tx-list">
      {transactions.map((tx) => (
        <div class="tx-row" id={`tx-${tx.id}`}>
          <div class="tx-cat-icon" style={`background: ${tx.color}22; color: ${tx.color};`}>
            {tx.tipo === 'ingreso' ? (
              <Icon name="icon_arrow_up_right" />
            ) : (
              <Icon name="icon_tag_list" />
            )}
          </div>
          <div class="tx-info">
            <p class="tx-description">{tx.description}</p>
            <p class="tx-meta">
              <span
                class="tx-category"
                style={`color: ${tx.tipo === 'ingreso' ? 'var(--money-out)' : tx.color};`}
              >
                {tx.tipo === 'ingreso' && tx.category === 'Otro' ? 'Ingreso' : tx.category}
              </span>
              <span class="tx-date">{tx.date} a las {tx.time}</span>
            </p>
          </div>
          <div class="tx-amount" style={tx.tipo === 'ingreso' ? 'color: var(--money-in);' : undefined}>
            {tx.tipo === 'ingreso' ? '+' : '-'}
            {tx.moneda === 'USD' ? 'U$D' : '$'}
            {formatDecimals(tx.amount)}
          </div>
        </div>
      ))}
    </div>
  ) : (
    <div class="empty-state" id="empty-transactions">
      <div class="empty-icon">
        <Icon name="icon_empty_inbox" />
      </div>
      <p class="empty-title">Sin transacciones</p>
      <p class="empty-hint">Enviá gastos a LUKA por WhatsApp para verlos acá.</p>
    </div>
  )
}
