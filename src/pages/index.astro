---
import '../styles/global.css';
import Icon from '../components/Icon.astro';

export const prerender = true;

const WHATSAPP_URL = 'https://wa.me/15556378961?text=Hola%20Luka%21';
const title = 'LUKA — Hacete cargo de tu plata sin planillas ni culpa';
const description =
  'Luka es tu asistente financiero por WhatsApp: anotá tus gastos como hablás y consultá balances, límites y gráficos sin planillas ni culpa.';
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/favicon-512.png', Astro.site);
const year = new Date().getFullYear();

const nav = [
  { href: '#como-funciona', label: 'Cómo funciona' },
  { href: '#beneficios', label: 'Beneficios' },
  { href: '#faq', label: 'Dudas' },
];

const wave = [30, 55, 80, 45, 95, 60, 35, 75, 50, 85, 40, 25];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#1B1420" />
    <link rel="icon" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Gabarito:wght@500;700&family=Inter:wght@300..800&display=swap"
    />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        root.classList.add('reveal-ready', 'hero-js');
        window.addEventListener('DOMContentLoaded', () => {
          const targets = document.querySelectorAll('[data-reveal]');
          const show = (el) => el.setAttribute('data-reveal', 'visible');
          if (!('IntersectionObserver' in window)) {
            targets.forEach(show);
            return;
          }
          const io = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (entry.isIntersecting) {
                  show(entry.target);
                  io.unobserve(entry.target);
                }
              }
            },
            { threshold: 0.12 },
          );
          targets.forEach((el) => io.observe(el));
        });
      })();
    </script>
  </head>
  <body>
    <header class="nav-wrap">
      <nav class="nav" aria-label="Principal">
        <a class="nav__brand" href="#hero">
          <img src="/logo-luka.png" alt="LUKA" width="30" height="30" />
          <span>LUKA</span>
        </a>
        <ul class="nav__links">
          {nav.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
        <span class="nav__spacer" aria-hidden="true"></span>
      </nav>
    </header>

    <main>
      <section class="hero" id="hero" aria-labelledby="hero-title">
        <div class="hero__copy">
          <h1 id="hero-title" class="hero__title">
            Hacete cargo de tu plata sin planillas ni culpa
          </h1>
          <p class="hero__sub">
            Escribile tus gastos como hablás y Luka los ordena: categorías, límites y balances
            cuando los pedís.
          </p>
          <div class="hero__actions">
            <a class="btn btn--primary" href={WHATSAPP_URL}>
              Empezá por WhatsApp
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M5 12h14" /><path d="m13 6 6 6-6 6" />
              </svg>
            </a>
            <a class="btn btn--ghost" href="#como-funciona">
              Ver cómo funciona
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M12 5v14" /><path d="m6 13 6 6 6-6" />
              </svg>
            </a>
          </div>
        </div>

        <div class="hero__art" data-hero-cards role="group" aria-label="Vista de producto">
          <!-- Mockup adaptado de «Great UI Mobile Mockup» (21st.dev, Saurabh Sharma, MIT). -->
          <div class="mini-dash stack-card" data-card="dashboard" data-reveal>
            <button
              class="stack-card__hit"
              type="button"
              aria-pressed="false"
              aria-label="Tarjeta Dashboard"
            ></button>
            <div aria-hidden="true">
              <p class="mini-dash__title">
                <svg class="mini-dash__menu" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                  <path d="M4 7h16" /><path d="M4 12h16" /><path d="M4 17h16" />
                </svg>
                Dashboard
              </p>
              <div class="donut">
                <span class="donut__hole"><b>100%</b><small>total</small></span>
              </div>
              <div class="mini-dash__bars">
                <div class="bar">
                  <span class="bar__label">Comida</span>
                  <span class="bar__track"><span class="bar__fill bar__fill--comida"></span></span>
                  <span class="bar__amount tabular">$20.000</span>
                </div>
                <div class="bar">
                  <span class="bar__label">Servicios</span>
                  <span class="bar__track"><span class="bar__fill bar__fill--servicios"></span></span>
                  <span class="bar__amount tabular">$12.000</span>
                </div>
                <div class="bar">
                  <span class="bar__label">Ocio</span>
                  <span class="bar__track"><span class="bar__fill bar__fill--ocio"></span></span>
                  <span class="bar__amount tabular">$8.000</span>
                </div>
                <div class="bar">
                  <span class="bar__label">Transporte</span>
                  <span class="bar__track"><span class="bar__fill bar__fill--transporte"></span></span>
                  <span class="bar__amount tabular">$5.000</span>
                </div>
              </div>
              <p class="mini-dash__balance">
                <span>Balance del mes</span>
                <b class="tabular">$805.000</b>
              </p>
            </div>
          </div>

          <div class="phone stack-card is-front" data-card="phone" data-seq data-reveal>
            <button
              class="stack-card__hit"
              type="button"
              aria-pressed="true"
              aria-label="Tarjeta WhatsApp"
            ></button>
            <span class="phone__side phone__side--left"></span>
            <span class="phone__side phone__side--right"></span>
            <div class="phone__body" aria-hidden="true">
              <span class="phone__island"></span>
              <div class="phone__status">
                <span>14:32</span>
                <span class="phone__status-icons">
                  <svg viewBox="0 0 24 24" fill="currentColor">
                    <rect x="2" y="15" width="3.5" height="6" rx="1" />
                    <rect x="8" y="11" width="3.5" height="10" rx="1" />
                    <rect x="14" y="7" width="3.5" height="14" rx="1" />
                    <rect x="20" y="3" width="3.5" height="18" rx="1" />
                  </svg>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M2 9a15 15 0 0 1 20 0" /><path d="M5.5 12.5a10 10 0 0 1 13 0" /><path d="M9 16a5 5 0 0 1 6 0" /><path d="M12 19.5h.01" />
                  </svg>
                  <svg viewBox="0 0 26 14" fill="none" stroke="currentColor" stroke-width="1.6">
                    <rect x="1" y="1" width="21" height="12" rx="3" /><rect x="3" y="3" width="12" height="8" rx="1.5" fill="currentColor" /><path d="M25 5v4" stroke-linecap="round" />
                  </svg>
                </span>
              </div>
              <div class="phone__header">
                <svg class="phone__header-back" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M19 12H5" /><path d="m12 19-7-7 7-7" />
                </svg>
                <img class="phone__avatar" src="/logo-luka.png" alt="LUKA" width="30" height="30" />
                <span class="phone__contact">
                  <b>Luka</b>
                  <small>Cuenta comercial</small>
                </span>
                <span class="phone__header-icons">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="23 7 16 12 23 17 23 7" /><rect x="1" y="5" width="15" height="14" rx="2" />
                  </svg>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
                  </svg>
                  <svg viewBox="0 0 24 24" fill="currentColor">
                    <circle cx="12" cy="5" r="1.8" /><circle cx="12" cy="12" r="1.8" /><circle cx="12" cy="19" r="1.8" />
                  </svg>
                </span>
              </div>
              <div class="phone__chat">
                <span class="chat__day">HOY</span>

                <div class="bubble bubble--user" data-seg="user">
                  Cobré 850000 de sueldo
                  <span class="bubble__meta">
                    <span class="bubble__time">14:32</span>
                    <svg class="bubble__ticks" viewBox="0 0 18 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M1 6.5 4.5 10 11 1" /><path d="M7 6.5 10.5 10 17 1" />
                    </svg>
                  </span>
                </div>
                <div class="chat__typing" data-seg="typing"><i></i><i></i><i></i></div>
                <div class="bubble bubble--luka" data-seg="reply">
                  <p>Listo: sueldo, <b class="tabular">+$850.000</b> en <b>Ingresos</b>.</p>
                  <span class="bubble__meta"><span class="bubble__time">14:32</span></span>
                </div>

                <div class="bubble bubble--user" data-seg="user">
                  Gasté 5000 en nafta
                  <span class="bubble__meta">
                    <span class="bubble__time">14:32</span>
                    <svg class="bubble__ticks" viewBox="0 0 18 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M1 6.5 4.5 10 11 1" /><path d="M7 6.5 10.5 10 17 1" />
                    </svg>
                  </span>
                </div>
                <div class="chat__typing" data-seg="typing"><i></i><i></i><i></i></div>
                <div class="bubble bubble--luka" data-seg="reply">
                  <p>Listo: nafta, <b class="tabular">$5.000</b> en <b>Transporte</b>.</p>
                  <span class="bubble__meta"><span class="bubble__time">14:32</span></span>
                </div>

                <div class="bubble bubble--user" data-seg="user">
                  Pagué 12000 de internet
                  <span class="bubble__meta">
                    <span class="bubble__time">14:33</span>
                    <svg class="bubble__ticks" viewBox="0 0 18 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M1 6.5 4.5 10 11 1" /><path d="M7 6.5 10.5 10 17 1" />
                    </svg>
                  </span>
                </div>
                <div class="chat__typing" data-seg="typing"><i></i><i></i><i></i></div>
                <div class="bubble bubble--luka" data-seg="reply">
                  <p>Listo: internet, <b class="tabular">$12.000</b> en <b>Servicios</b>.<br />Balance del mes: <b class="tabular">$805.000</b></p>
                  <span class="bubble__meta"><span class="bubble__time">14:33</span></span>
                </div>
              </div>
              <div class="phone__input">
                <span class="phone__plus">+</span>
                <span class="phone__placeholder">Escribí o mandá un audio…</span>
                <span class="phone__mic">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <rect x="9" y="3" width="6" height="11" rx="3" /><path d="M5 11a7 7 0 0 0 14 0" /><path d="M12 18v3" />
                  </svg>
                </span>
              </div>
              <span class="phone__home"></span>
            </div>
          </div>
        </div>
      </section>

      <section class="section" id="beneficios" aria-labelledby="benefits-title">
        <div class="shell">
          <h2 id="benefits-title" class="section__title">
            Diseñado para darte claridad, no trabajo
          </h2>
          <p class="section__sub">Menos fricción, más control.</p>

          <div class="bento">
            <article class="tile tile--a" data-reveal>
              <span class="tile__icon tile__icon--transporte"><Icon name="icon_tag_list" /></span>
              <span class="tile__badge">Clasificado</span>
              <h3>Categorías automáticas</h3>
              <p>Entiende lo que escribís y lo ordena solo.</p>
              <div class="flow" aria-hidden="true">
                <span class="flow__msg">Gasté 5000 en nafta</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M5 12h14" /><path d="m13 6 6 6-6 6" />
                </svg>
                <span class="chip chip--transporte">Transporte</span>
                <span class="chip chip--neutral">Nafta</span>
                <span class="chip chip--neutral tabular">$5.000</span>
              </div>
            </article>

            <article class="tile tile--b" data-reveal>
              <span class="tile__icon tile__icon--durazno"><Icon name="icon_activity" /></span>
              <h3>Registrás en segundos</h3>
              <p>Texto o audio, mientras caminás.</p>
              <div class="audio" aria-hidden="true">
                <span class="audio__play">
                  <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
                </span>
                <span class="wave">
                  {wave.map((h) => <i style={`--h:${h}%`} />)}
                </span>
                <span class="audio__time tabular">0:04</span>
              </div>
              <p class="audio__transcript" aria-hidden="true">«Gasté 5000 en nafta» · Transcrito</p>
            </article>

            <article class="tile tile--c" data-reveal>
              <span class="tile__icon tile__icon--amber"><Icon name="icon_alert" /></span>
              <h3>Límites que avisan</h3>
              <p>Alertas antes de que se termine el mes.</p>
              <div class="limit" aria-hidden="true">
                <span class="limit__label">Comida</span>
                <span class="limit__pct tabular">80%</span>
                <span class="limit__track"><span class="limit__fill"></span></span>
                <span class="limit__amounts tabular">$80.000 de $100.000</span>
              </div>
            </article>

            <article class="tile tile--d" data-reveal>
              <span class="tile__icon tile__icon--olive"><Icon name="icon_trend_up" /></span>
              <h3>Balances claros</h3>
              <p>Totales en tiempo real, sin abrir planillas.</p>
              <div class="balance" aria-hidden="true">
                <span class="balance__label">Superávit del mes</span>
                <span class="balance__value tabular">$12.500</span>
                <svg class="spark" viewBox="0 0 120 40" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="0,32 20,28 40,30 60,20 80,22 100,10 120,6" />
                </svg>
              </div>
            </article>

            <article class="tile tile--e" data-reveal>
              <span class="tile__icon tile__icon--lila"><Icon name="icon_dollar" /></span>
              <h3>Sin planillas</h3>
              <p>Tus cuentas al día sin fórmulas rotas.</p>
              <ul class="ledger" aria-hidden="true">
                <li>
                  <span class="dot dot--olive"></span> Honorarios
                  <b class="tabular ledger__in">+$140.000</b>
                </li>
                <li>
                  <span class="dot dot--warm"></span> Supermercado
                  <b class="tabular ledger__out">-$28.400</b>
                </li>
              </ul>
            </article>
          </div>
        </div>
      </section>

      <section class="section" aria-labelledby="conflict-title">
        <div class="shell">
          <h2 id="conflict-title" class="section__title">
            El problema no sos vos. Son las herramientas.
          </h2>
          <div class="faceoff">
            <div class="faceoff__side faceoff__side--hoy" data-reveal>
              <p class="faceoff__label">HOY</p>
              <p class="faceoff__sub">La plata se va y no sabés bien adónde</p>
              <div class="chaos" aria-hidden="true">
                <span class="chaos__card chaos__card--1">Ticket supermercado <b class="tabular">$8.400</b></span>
                <span class="chaos__card chaos__card--2">Notificación banco</span>
                <span class="chaos__card chaos__card--3">Resumen de tarjeta</span>
                <span class="chaos__card chaos__card--4">¿Cuánto gasté este mes?</span>
              </div>
            </div>
            <span class="faceoff__line" aria-hidden="true"></span>
            <div class="faceoff__side faceoff__side--luka" data-reveal>
              <p class="faceoff__label faceoff__label--luka">CON LUKA</p>
              <p class="faceoff__sub">Todo queda ordenado sin que hagas nada extra</p>
              <div class="ordered" aria-hidden="true">
                <span class="chip chip--transporte">Transporte <b class="tabular">$5.000</b></span>
                <span class="chip chip--comida">Comida <b class="tabular">$12.300</b></span>
                <span class="chip chip--servicios">Servicios <b class="tabular">$8.900</b></span>
                <span class="ordered__balance">
                  Balance del mes <b class="tabular">$12.500</b>
                </span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="section" id="como-funciona" aria-labelledby="plan-title">
        <div class="shell">
          <h2 id="plan-title" class="section__title">
            Escribilo y olvidate. LUKA se acuerda por vos.
          </h2>
          <p class="section__sub">Tres pasos, cero planillas.</p>

          <ol class="steps">
            <li class="step" data-reveal>
              <span class="step__node" aria-hidden="true">1</span>
              <h3>Escribís como hablás</h3>
              <p>Un mensaje o un audio: «Gasté 5000 en nafta».</p>
              <div class="step__viz" aria-hidden="true">
                <span class="flow__msg">Gasté 5000 en nafta</span>
                <span class="audio">
                  <span class="audio__play">
                    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
                  </span>
                  <span class="wave">
                    {wave.slice(0, 9).map((h) => <i style={`--h:${h}%`} />)}
                  </span>
                  <span class="audio__time tabular">0:04</span>
                </span>
              </div>
            </li>

            <li class="step" data-reveal>
              <span class="step__node" aria-hidden="true">2</span>
              <h3>El cerebro de LUKA lo entiende</h3>
              <p>Detecta monto, categoría y fecha.</p>
              <div class="core" aria-hidden="true">
                <span class="core__input">Gasté 5000 en nafta</span>
                <span class="core__orb"></span>
                <span class="core__tags">
                  <span class="core__tag core__tag--monto">Monto <b class="tabular">$5.000</b></span>
                  <span class="core__tag core__tag--cat">Categoría <b>Transporte</b></span>
                  <span class="core__tag core__tag--fecha">Fecha <b>Hoy</b></span>
                </span>
              </div>
            </li>

            <li class="step" data-reveal>
              <span class="step__node" aria-hidden="true">3</span>
              <h3>Ves todo ordenado</h3>
              <p>Balances, límites y gráficos cuando los pedís.</p>
              <div class="step__viz" aria-hidden="true">
                <span class="move">
                  <span class="move__cat">Transporte</span> Nafta
                  <b class="tabular ledger__out">-$5.000</b>
                </span>
                <span class="move__balance">
                  Balance del mes <b class="tabular">$12.500</b>
                </span>
              </div>
            </li>
          </ol>
        </div>
      </section>

      <section class="section" id="faq" aria-labelledby="faq-title">
        <div class="shell faq__grid">
          <h2 id="faq-title" class="section__title">Las dudas de siempre</h2>
          <div class="faq__list">
            <details class="faq__item" data-reveal>
              <summary>
                ¿Necesito instalar algo?
                <span class="faq__plus" aria-hidden="true">+</span>
              </summary>
              <p>No. Usás el WhatsApp que ya tenés.</p>
            </details>
            <details class="faq__item" data-reveal>
              <summary>
                ¿Cuánto tarda en registrar un gasto?
                <span class="faq__plus" aria-hidden="true">+</span>
              </summary>
              <p>Segundos. Luka lo anota, lo clasifica y te lo confirma al instante.</p>
            </details>
            <details class="faq__item" data-reveal>
              <summary>
                ¿Puedo anotar gastos en efectivo?
                <span class="faq__plus" aria-hidden="true">+</span>
              </summary>
              <p>Sí, también ingresos. Por texto o audio, como te salga.</p>
            </details>
            <details class="faq__item" data-reveal>
              <summary>
                ¿Qué puedo consultarle?
                <span class="faq__plus" aria-hidden="true">+</span>
              </summary>
              <p>Balances, límites y gráficos por WhatsApp, o en detalle desde el dashboard.</p>
            </details>
            <details class="faq__item" data-reveal>
              <summary>
                ¿Y si mi mensaje es ambiguo?
                <span class="faq__plus" aria-hidden="true">+</span>
              </summary>
              <p>Luka te repregunta de forma simple en vez de cargar algo mal.</p>
            </details>
          </div>
        </div>
      </section>

      <section class="closing" id="cierre" aria-labelledby="closing-title">
        <div class="shell">
          <div class="closing__inner">
            <h2 id="closing-title">Empezá a ordenar tu plata hoy</h2>
            <p>Enviá tu primer gasto y mirá cómo Luka lo ordena.</p>
            <a class="btn btn--dark" href={WHATSAPP_URL}>
              Empezá por WhatsApp
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M5 12h14" /><path d="m13 6 6 6-6 6" />
              </svg>
            </a>
          </div>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="shell footer__inner">
        <img src="/logo-luka.png" alt="LUKA" width="26" height="26" />
        <p>LUKA © {year} — Todos los derechos reservados</p>
      </div>
    </footer>

    <style>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        background: var(--bg-base);
      }

      body {
        overflow-x: clip;
      }

      .shell {
        width: 100%;
        max-width: 1200px;
        margin-inline: auto;
        padding-inline: 24px;
      }

      section[id] {
        scroll-margin-top: 96px;
      }

      .nav-wrap {
        position: sticky;
        top: 16px;
        z-index: 50;
        padding-inline: 16px;
      }

      .nav {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 12px;
        width: 100%;
        max-width: 1200px;
        margin-inline: auto;
        padding: 10px 12px 10px 20px;
        background: rgba(39, 28, 46, 0.55);
        -webkit-backdrop-filter: blur(18px);
        backdrop-filter: blur(18px);
        border: 1px solid var(--border);
        border-radius: var(--radius-full);
        box-shadow: var(--shadow-card);
      }

      .nav__brand {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        color: var(--text-primary);
        font: 700 18px/1 var(--font-display);
        text-decoration: none;
      }

      .nav__brand img {
        border-radius: 50%;
      }

      .nav__links {
        display: flex;
        gap: 2px;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .nav__links a {
        display: inline-block;
        padding: 9px 14px;
        border-radius: var(--radius-full);
        color: var(--text-secondary);
        font: var(--text-body-md);
        text-decoration: none;
        transition:
          color var(--duration-fast) var(--ease-out),
          background var(--duration-fast) var(--ease-out);
      }

      .nav__links a:hover {
        color: var(--text-primary);
        background: var(--bg-glass);
      }

      .nav__links a:focus-visible,
      .nav__brand:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 14px 24px;
        border: 1px solid transparent;
        border-radius: var(--radius-md);
        font: 600 15px/1 var(--font-ui);
        text-decoration: none;
        transition:
          transform var(--duration-fast) var(--ease-out),
          background var(--duration-fast) var(--ease-out),
          border-color var(--duration-fast) var(--ease-out);
      }

      .btn svg {
        width: 16px;
        height: 16px;
      }

      .btn:hover {
        transform: translateY(-2px);
      }

      .btn:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }

      .btn--primary {
        background: var(--action);
        color: var(--on-action);
        box-shadow: var(--shadow-glow);
      }

      .btn--primary:hover {
        background: var(--action-hover);
      }

      .btn--ghost {
        border-color: var(--border-strong);
        color: var(--text-primary);
      }

      .btn--ghost:hover {
        background: var(--bg-glass);
      }

      .btn--dark {
        background: var(--berry-900);
        color: var(--text-primary);
      }

      .btn--dark:hover {
        background: var(--berry-800);
      }

      .hero {
        display: grid;
        gap: 48px;
        align-items: center;
        width: 100%;
        max-width: 1200px;
        margin-inline: auto;
        padding: 88px 24px 40px;
      }

      .hero__title {
        margin: 0;
        font: 700 clamp(40px, 5.4vw, 56px) / 1.08 var(--font-display);
        letter-spacing: -0.02em;
      }

      .hero__sub {
        max-width: 46ch;
        margin: 20px 0 0;
        font: var(--text-body-lg);
        color: var(--text-secondary);
      }

      .hero__actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 32px;
      }

      .hero__art {
        position: relative;
        min-height: 540px;
      }

      .stack-card__hit {
        position: absolute;
        inset: 0;
        z-index: 2;
        padding: 0;
        background: none;
        border: 0;
        border-radius: inherit;
        cursor: pointer;
      }

      .stack-card__hit:focus-visible {
        outline: 2px solid var(--action);
        outline-offset: 3px;
      }

      .mini-dash {
        position: absolute;
        top: 96px;
        left: 0;
        width: min(280px, 76%);
        padding: 18px;
        background: var(--bg-surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-card);
      }

      .mini-dash__title {
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 0 0 14px;
        font: var(--text-caption);
        color: var(--text-secondary);
        text-transform: uppercase;
        letter-spacing: 0.06em;
      }

      .mini-dash__menu {
        flex: none;
        width: 15px;
        height: 15px;
        color: var(--text-secondary);
      }

      .dot {
        display: inline-block;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--text-muted);
      }

      .dot--olive {
        background: var(--money-in);
      }

      .dot--warm {
        background: var(--money-out);
      }

      .donut {
        display: grid;
        place-items: center;
        width: 132px;
        aspect-ratio: 1;
        margin-inline: auto;
        border-radius: 50%;
        background: conic-gradient(
          var(--cat-comida) 0 44.4%,
          var(--cat-servicios) 44.4% 71.1%,
          var(--cat-ocio) 71.1% 88.9%,
          var(--cat-transporte) 88.9% 100%
        );
      }

      .donut__hole {
        display: grid;
        place-items: center;
        width: 62%;
        aspect-ratio: 1;
        border-radius: 50%;
        background: var(--bg-surface);
      }

      .donut__hole b {
        font: 700 20px/1 var(--font-display);
      }

      .donut__hole small {
        font: var(--text-caption);
        color: var(--text-muted);
      }

      .mini-dash__bars {
        display: grid;
        gap: 10px;
        margin-top: 16px;
      }

      .bar {
        display: grid;
        grid-template-columns: 72px 1fr auto;
        align-items: center;
        gap: 10px;
      }

      .bar__label {
        font: var(--text-body-sm);
        color: var(--text-secondary);
      }

      .bar__amount {
        font: var(--text-caption);
        color: var(--text-muted);
      }

      .bar__track {
        height: 6px;
        border-radius: var(--radius-full);
        background: var(--bg-glass);
        overflow: hidden;
      }

      .bar__fill {
        display: block;
        height: 100%;
        border-radius: inherit;
      }

      .bar__fill--comida {
        width: 44.4%;
        background: var(--cat-comida);
      }

      .bar__fill--servicios {
        width: 26.7%;
        background: var(--cat-servicios);
      }

      .bar__fill--ocio {
        width: 17.8%;
        background: var(--cat-ocio);
      }

      .bar__fill--transporte {
        width: 11.1%;
        background: var(--cat-transporte);
      }

      .mini-dash__balance {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 10px;
        margin: 16px 0 0;
        padding-top: 12px;
        border-top: 1px solid var(--border);
      }

      .mini-dash__balance span {
        font: var(--text-caption);
        color: var(--text-secondary);
      }

      .mini-dash__balance b {
        font: 700 16px/1 var(--font-display);
      }

      .phone {
        position: absolute;
        top: 12px;
        right: 0;
        z-index: 1;
        width: min(300px, 78%);
        height: 588px;
        padding: 10px;
        background: var(--bg-elevated);
        border: 1px solid var(--border-strong);
        border-radius: 40px;
        box-shadow: var(--shadow-card);
      }

      .phone__body {
        display: flex;
        flex-direction: column;
        height: 100%;
      }

      .phone__side {
        position: absolute;
        width: 3px;
        border-radius: 2px;
        background: var(--berry-950);
      }

      .phone__side--left {
        top: 110px;
        left: -2px;
        height: 26px;
        box-shadow:
          0 42px 0 var(--berry-950),
          0 84px 0 var(--berry-950);
      }

      .phone__side--right {
        top: 150px;
        right: -2px;
        height: 58px;
      }

      .phone__island {
        display: block;
        width: 96px;
        height: 24px;
        margin: 6px auto 8px;
        border-radius: var(--radius-full);
        background: var(--berry-950);
      }

      .phone__status {
        display: flex;
        justify-content: space-between;
        padding: 0 18px 8px;
        font: var(--text-caption);
        color: var(--text-muted);
      }

      .phone__status-icons {
        display: inline-flex;
        align-items: center;
        gap: 5px;
      }

      .phone__status-icons svg {
        width: 14px;
        height: 11px;
        opacity: 0.7;
      }

      .phone__header {
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 8px 12px 10px;
        border-bottom: 1px solid var(--border);
      }

      .phone__header-back {
        flex: none;
        width: 16px;
        height: 16px;
        color: var(--text-secondary);
      }

      .phone__avatar {
        flex: none;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        object-fit: cover;
      }

      .phone__contact {
        display: flex;
        flex: 1;
        flex-direction: column;
        min-width: 0;
      }

      .phone__contact b {
        font: 600 13px/1.25 var(--font-ui);
      }

      .phone__contact small {
        font: var(--text-caption);
        color: var(--text-muted);
      }

      .phone__header-icons {
        display: inline-flex;
        flex: none;
        gap: 9px;
        color: var(--text-secondary);
      }

      .phone__header-icons svg {
        width: 15px;
        height: 15px;
      }

      .phone__chat {
        position: relative;
        display: grid;
        flex: 1;
        min-height: 0;
        gap: 10px;
        padding: 14px 12px;
        overflow-y: auto;
        scrollbar-width: none;
      }

      .phone__chat::-webkit-scrollbar {
        display: none;
      }

      [data-seg] {
        transition:
          opacity var(--duration-base) var(--ease-out),
          transform var(--duration-base) var(--ease-out);
      }

      .hero-js [data-seg] {
        opacity: 0;
        transform: translateY(8px);
      }

      .hero-js [data-seg].is-on {
        opacity: 1;
        transform: none;
      }

      .chat__typing {
        display: none;
        justify-self: start;
        gap: 4px;
        padding: 9px 13px;
        background: var(--bg-surface);
        border-radius: 18px 18px 18px 4px;
      }

      .hero-js .chat__typing.is-on {
        display: flex;
      }

      .chat__typing i {
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: var(--text-muted);
        animation: typing-bounce 0.6s ease-in-out infinite;
      }

      .chat__typing i:nth-child(2) {
        animation-delay: 0.15s;
      }

      .chat__typing i:nth-child(3) {
        animation-delay: 0.3s;
      }

      @keyframes typing-bounce {
        0%,
        100% {
          opacity: 0.45;
          transform: translateY(0);
        }

        50% {
          opacity: 1;
          transform: translateY(-3px);
        }
      }

      .phone__home {
        flex: none;
        width: 96px;
        height: 4px;
        margin: 6px auto 2px;
        border-radius: var(--radius-full);
        background: var(--text-muted);
        opacity: 0.5;
      }

      .chat__day {
        justify-self: center;
        padding: 3px 10px;
        border-radius: var(--radius-full);
        background: var(--bg-glass);
        font: var(--text-caption);
        color: var(--text-muted);
      }

      .bubble {
        padding: 11px 14px;
        font: var(--text-body-sm);
      }

      .bubble--user {
        justify-self: end;
        max-width: 88%;
        background: color-mix(in srgb, var(--action) 24%, var(--bg-elevated));
        border-radius: 18px 18px 4px 18px;
      }

      .bubble__meta {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 4px;
        margin-top: 4px;
      }

      .bubble__time {
        font: var(--text-caption);
        color: var(--text-muted);
      }

      .bubble__ticks {
        width: 16px;
        height: 11px;
        color: #53bdeb;
      }

      .bubble--luka {
        max-width: 94%;
        background: var(--bg-surface);
        border-radius: 18px 18px 18px 4px;
      }

      .bubble--luka p {
        margin: 0;
      }

      .phone__input {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 4px 10px 12px;
        padding: 9px 12px;
        background: var(--bg-surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-full);
        color: var(--text-muted);
        font: var(--text-body-sm);
      }

      .phone__placeholder {
        flex: 1;
        overflow: hidden;
        white-space: nowrap;
        text-overflow: ellipsis;
      }

      .phone__plus {
        display: grid;
        place-items: center;
        width: 22px;
        height: 22px;
        border-radius: 50%;
        background: var(--bg-glass);
        color: var(--text-secondary);
        font: var(--text-body-sm);
      }

      .phone__mic {
        display: inline-flex;
        width: 26px;
        height: 26px;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: var(--action);
        color: var(--on-action);
      }

      .phone__mic svg {
        width: 15px;
        height: 15px;
      }

      .section {
        padding-top: clamp(72px, 9vw, 120px);
      }

      .section__title {
        margin: 0;
        font: 700 clamp(30px, 3.8vw, 42px) / 1.12 var(--font-display);
        letter-spacing: -0.015em;
      }

      .section__sub {
        margin: 14px 0 0;
        font: var(--text-body-lg);
        color: var(--text-secondary);
      }

      .bento {
        display: grid;
        gap: 20px;
        margin-top: 44px;
      }

      .tile {
        position: relative;
        padding: 24px;
        background: var(--bg-surface);
        border: 1px solid var(--border);
        border-radius: 24px;
        box-shadow: var(--shadow-card);
      }

      .tile h3 {
        margin: 16px 0 0;
        font: var(--text-heading-lg);
      }

      .tile p {
        margin: 6px 0 0;
        font: var(--text-body-md);
        color: var(--text-secondary);
      }

      .tile__icon {
        display: inline-grid;
        place-items: center;
        width: 42px;
        height: 42px;
        border-radius: 13px;
        background: var(--bg-glass);
        color: var(--text-secondary);
      }

      .tile__icon--transporte {
        color: var(--cat-transporte);
        background: color-mix(in srgb, var(--cat-transporte) 16%, transparent);
      }

      .tile__icon--durazno {
        color: var(--accent);
        background: color-mix(in srgb, var(--accent) 16%, transparent);
      }

      .tile__icon--amber {
        color: var(--warning);
        background: color-mix(in srgb, var(--warning) 16%, transparent);
      }

      .tile__icon--olive {
        color: var(--money-in);
        background: color-mix(in srgb, var(--money-in) 16%, transparent);
      }

      .tile__icon--lila {
        color: var(--cat-servicios);
        background: color-mix(in srgb, var(--cat-servicios) 16%, transparent);
      }

      .tile__badge {
        position: absolute;
        top: 24px;
        right: 24px;
        padding: 5px 12px;
        border-radius: var(--radius-full);
        background: color-mix(in srgb, var(--money-in) 16%, transparent);
        color: var(--money-in);
        font: var(--text-caption);
      }

      .tile--a {
        background: color-mix(in srgb, var(--cat-transporte) 8%, var(--bg-surface));
      }

      .tile--c {
        background: color-mix(in srgb, var(--warning) 7%, var(--bg-surface));
      }

      .tile--d {
        background: color-mix(in srgb, var(--money-in) 7%, var(--bg-surface));
      }

      .flow {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;
        margin-top: 22px;
      }

      .flow svg {
        width: 16px;
        height: 16px;
        color: var(--text-muted);
      }

      .flow__msg {
        padding: 8px 12px;
        border: 1px solid var(--border);
        border-radius: 12px;
        background: var(--bg-elevated);
        font: var(--text-body-sm);
      }

      .chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 12px;
        border-radius: var(--radius-full);
        border: 1px solid var(--border);
        background: var(--bg-glass);
        font: var(--text-caption);
        color: var(--text-secondary);
      }

      .chip b {
        color: var(--text-primary);
        font-weight: 600;
      }

      .chip--transporte {
        border-color: color-mix(in srgb, var(--cat-transporte) 40%, transparent);
        background: color-mix(in srgb, var(--cat-transporte) 14%, transparent);
      }

      .chip--comida {
        border-color: color-mix(in srgb, var(--cat-comida) 40%, transparent);
        background: color-mix(in srgb, var(--cat-comida) 14%, transparent);
      }

      .chip--servicios {
        border-color: color-mix(in srgb, var(--cat-servicios) 40%, transparent);
        background: color-mix(in srgb, var(--cat-servicios) 14%, transparent);
      }

      .chip--neutral {
        background: var(--bg-elevated);
      }

      .audio {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-top: 20px;
        padding: 10px 14px;
        border: 1px solid var(--border);
        border-radius: var(--radius-md);
        background: var(--bg-elevated);
      }

      .audio__play {
        display: inline-grid;
        place-items: center;
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background: var(--action);
        color: var(--on-action);
      }

      .audio__play svg {
        width: 14px;
        height: 14px;
      }

      .wave {
        display: inline-flex;
        flex: 1;
        align-items: center;
        gap: 3px;
        height: 26px;
        color: var(--accent);
      }

      .wave i {
        display: block;
        width: 3px;
        height: var(--h);
        border-radius: 2px;
        background: currentColor;
      }

      .audio__time {
        font: var(--text-caption);
        color: var(--text-muted);
      }

      .audio__transcript {
        margin: 10px 0 0;
        font: var(--text-caption);
        color: var(--text-muted);
      }

      .limit {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 8px 10px;
        margin-top: 22px;
      }

      .limit__label {
        font: var(--text-body-sm);
        color: var(--text-secondary);
      }

      .limit__pct {
        font: 600 14px/1 var(--font-ui);
        color: var(--warning);
      }

      .limit__track {
        grid-column: 1 / -1;
        height: 8px;
        border-radius: var(--radius-full);
        background: var(--bg-glass);
        overflow: hidden;
      }

      .limit__fill {
        display: block;
        width: 80%;
        height: 100%;
        background: var(--warning);
      }

      .limit__amounts {
        grid-column: 1 / -1;
        font: var(--text-caption);
        color: var(--text-muted);
      }

      .balance {
        margin-top: 22px;
        padding: 16px;
        border: 1px solid var(--border);
        border-radius: var(--radius-md);
        background: var(--bg-elevated);
      }

      .balance__label {
        display: block;
        font: var(--text-caption);
        color: var(--text-secondary);
      }

      .balance__value {
        display: block;
        margin-top: 4px;
        font: 700 28px/1.1 var(--font-display);
      }

      .spark {
        width: 100%;
        height: 40px;
        margin-top: 10px;
        color: var(--money-in);
      }

      .ledger {
        display: grid;
        gap: 10px;
        margin: 22px 0 0;
        padding: 14px 16px;
        border: 1px solid var(--border);
        border-radius: var(--radius-md);
        background: var(--bg-elevated);
        list-style: none;
        font: var(--text-body-sm);
      }

      .ledger li {
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--text-secondary);
      }

      .ledger b {
        margin-left: auto;
        font-weight: 600;
      }

      .ledger__in {
        color: var(--money-in);
      }

      .ledger__out {
        color: var(--money-out);
      }

      .faceoff {
        position: relative;
        display: grid;
        gap: 24px;
        margin-top: 44px;
      }

      .faceoff__side {
        padding: 28px;
        border: 1px solid var(--border);
        border-radius: 24px;
      }

      .faceoff__side--hoy {
        background: color-mix(in srgb, var(--money-out) 6%, var(--bg-surface));
      }

      .faceoff__side--luka {
        background: color-mix(in srgb, var(--action) 8%, var(--bg-surface));
      }

      .faceoff__label {
        margin: 0;
        font: var(--text-caption);
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--money-out);
      }

      .faceoff__label--luka {
        color: var(--action);
      }

      .faceoff__sub {
        margin: 10px 0 0;
        font: var(--text-heading-md);
      }

      .faceoff__line {
        display: none;
      }

      .chaos {
        position: relative;
        min-height: 240px;
        margin-top: 24px;
      }

      .chaos__card {
        position: absolute;
        padding: 12px 16px;
        border: 1px solid var(--border);
        border-radius: 12px;
        background: var(--bg-elevated);
        font: var(--text-body-sm);
        color: var(--money-out);
        box-shadow: var(--shadow-card);
      }

      .chaos__card b {
        display: block;
        margin-top: 4px;
        color: var(--text-secondary);
      }

      .chaos__card--1 {
        top: 8px;
        left: 4%;
        rotate: -5deg;
      }

      .chaos__card--2 {
        top: 72px;
        left: 30%;
        rotate: 4deg;
      }

      .chaos__card--3 {
        top: 148px;
        left: 8%;
        rotate: -2deg;
      }

      .chaos__card--4 {
        top: 108px;
        left: 58%;
        rotate: 7deg;
      }

      .ordered {
        display: grid;
        gap: 10px;
        margin-top: 24px;
      }

      .ordered .chip {
        justify-content: space-between;
      }

      .ordered__balance {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: 6px;
        padding: 14px 16px;
        border-radius: var(--radius-md);
        background: var(--gradient-brand-soft);
        border: 1px solid var(--border-strong);
        font: var(--text-body-sm);
        color: var(--text-secondary);
      }

      .ordered__balance b {
        font: 700 18px/1 var(--font-display);
        color: var(--text-primary);
      }

      .steps {
        position: relative;
        display: grid;
        gap: 20px;
        margin: 44px 0 0;
        padding: 0;
        list-style: none;
      }

      .step {
        position: relative;
        padding: 26px;
        background: var(--bg-surface);
        border: 1px solid var(--border);
        border-radius: 24px;
        box-shadow: var(--shadow-card);
      }

      .step__node {
        display: inline-grid;
        place-items: center;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        border: 1px solid color-mix(in srgb, var(--action) 55%, transparent);
        background: color-mix(in srgb, var(--action) 14%, var(--bg-surface));
        color: var(--action);
        font: 700 15px/1 var(--font-display);
      }

      .step h3 {
        margin: 16px 0 0;
        font: var(--text-heading-lg);
      }

      .step > p {
        margin: 6px 0 0;
        font: var(--text-body-md);
        color: var(--text-secondary);
      }

      .step__viz {
        display: grid;
        gap: 10px;
        margin-top: 20px;
      }

      .step__viz .flow__msg {
        justify-self: start;
      }

      .core {
        display: grid;
        justify-items: center;
        gap: 12px;
        margin-top: 20px;
        padding: 20px 16px;
        border: 1px solid var(--border);
        border-radius: var(--radius-md);
        background: var(--bg-elevated);
      }

      .core__input {
        padding: 8px 12px;
        border: 1px solid var(--border);
        border-radius: 12px;
        background: var(--bg-surface);
        font: var(--text-body-sm);
        color: var(--text-secondary);
      }

      .core__orb {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: var(--action);
        box-shadow: var(--shadow-glow);
      }

      .core__tags {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 8px;
      }

      .core__tag {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 12px;
        border: 1px solid var(--border);
        border-radius: var(--radius-full);
        background: var(--bg-surface);
        font: var(--text-caption);
        color: var(--text-secondary);
      }

      .core__tag b {
        color: var(--text-primary);
      }

      .core__tag--monto {
        border-color: var(--border-strong);
      }

      .core__tag--cat {
        border-color: color-mix(in srgb, var(--cat-transporte) 45%, transparent);
        background: color-mix(in srgb, var(--cat-transporte) 12%, transparent);
      }

      .core__tag--fecha {
        border-color: color-mix(in srgb, var(--warning) 45%, transparent);
        background: color-mix(in srgb, var(--warning) 12%, transparent);
      }

      .move {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 12px 14px;
        border: 1px solid var(--border);
        border-radius: var(--radius-md);
        background: var(--bg-elevated);
        font: var(--text-body-sm);
      }

      .move__cat {
        padding: 4px 10px;
        border-radius: var(--radius-full);
        background: color-mix(in srgb, var(--cat-transporte) 16%, transparent);
        color: var(--cat-transporte);
        font: var(--text-caption);
      }

      .move b {
        margin-left: auto;
      }

      .move__balance {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 14px;
        border: 1px solid var(--border);
        border-radius: var(--radius-md);
        background: var(--bg-surface);
        font: var(--text-body-sm);
        color: var(--text-secondary);
      }

      .move__balance b {
        font: 700 18px/1 var(--font-display);
        color: var(--text-primary);
      }

      .faq__grid {
        display: grid;
        gap: 32px;
      }

      .faq__list {
        display: grid;
        gap: 12px;
      }

      .faq__item {
        border: 1px solid var(--border);
        border-radius: var(--radius-md);
        background: var(--bg-surface);
        overflow: hidden;
      }

      .faq__item summary {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 18px 20px;
        cursor: pointer;
        font: var(--text-heading-md);
        list-style: none;
      }

      .faq__item summary::-webkit-details-marker {
        display: none;
      }

      .faq__item summary:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: -2px;
      }

      .faq__plus {
        flex: none;
        color: var(--accent);
        font: 500 20px/1 var(--font-ui);
        transition: transform var(--duration-fast) var(--ease-out);
      }

      .faq__item[open] .faq__plus {
        transform: rotate(45deg);
      }

      .faq__item p {
        margin: 0;
        padding: 0 20px 18px;
        font: var(--text-body-md);
        color: var(--text-secondary);
      }

      .closing {
        padding-top: clamp(72px, 9vw, 120px);
      }

      .closing__inner {
        padding: clamp(40px, 6vw, 72px);
        border-radius: var(--radius-xl);
        background: var(--gradient-brand);
        color: var(--espresso-950);
        text-align: center;
        box-shadow: var(--shadow-glow);
      }

      .closing__inner h2 {
        margin: 0;
        font: 700 clamp(28px, 3.6vw, 40px) / 1.1 var(--font-display);
        letter-spacing: -0.015em;
      }

      .closing__inner p {
        margin: 12px 0 0;
        font: var(--text-body-lg);
      }

      .closing__inner .btn {
        margin-top: 28px;
      }

      .footer {
        padding: 48px 24px 32px;
      }

      .footer__inner {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        color: var(--text-muted);
      }

      .footer__inner img {
        border-radius: 50%;
      }

      .footer__inner p {
        margin: 0;
        font: var(--text-body-sm);
      }

      .reveal-ready [data-reveal] {
        opacity: 0;
        transform: translateY(16px);
        transition:
          opacity var(--duration-slow) var(--ease-out),
          transform var(--duration-slow) var(--ease-out);
      }

      .reveal-ready [data-reveal='visible'] {
        opacity: 1;
        transform: none;
      }

      @media (min-width: 720px) {
        .faq__grid {
          grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
          gap: 48px;
          align-items: start;
        }

        .faceoff {
          grid-template-columns: 1fr 1fr;
          gap: 40px;
        }

        .faceoff__line {
          display: block;
          position: absolute;
          top: 12%;
          bottom: 12%;
          left: 50%;
          width: 2px;
          background: linear-gradient(180deg, transparent, var(--action), transparent);
          opacity: 0.5;
        }

        .chaos {
          min-height: 300px;
        }
      }

      @media (min-width: 900px) {
        .bento {
          grid-template-columns: repeat(3, 1fr);
          grid-template-areas:
            'a a b'
            'c d e';
        }

        .tile--a {
          grid-area: a;
        }

        .tile--b {
          grid-area: b;
        }

        .tile--c {
          grid-area: c;
        }

        .tile--d {
          grid-area: d;
        }

        .tile--e {
          grid-area: e;
        }

        .steps {
          grid-template-columns: repeat(3, 1fr);
        }

        .steps::before {
          content: '';
          position: absolute;
          top: 44px;
          left: 10%;
          right: 10%;
          height: 2px;
          background: linear-gradient(90deg, var(--action), var(--accent));
          opacity: 0.45;
        }

        .step {
          z-index: 1;
        }
      }

      @media (min-width: 960px) {
        .hero {
          grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
          padding-top: 112px;
          padding-bottom: 64px;
        }

        .hero__art {
          min-height: 616px;
        }

        .stack-card {
          transition:
            translate var(--duration-slow) var(--ease-out),
            scale var(--duration-slow) var(--ease-out),
            box-shadow var(--duration-slow) var(--ease-out),
            filter var(--duration-slow) var(--ease-out);
        }

        .stack-card:not(.is-front) {
          translate: 0 12px;
          scale: 0.98;
          filter: brightness(0.9);
        }

        .stack-card.is-front {
          z-index: 2;
        }

        .stack-card.is-front:hover {
          translate: 0 -4px;
        }
      }

      @media (max-width: 719px) {
        .nav {
          grid-template-columns: 1fr auto;
        }

        .nav__links {
          display: none;
        }

        .nav__spacer {
          display: none;
        }
      }

      @media (max-width: 959px) {
        .hero__art {
          display: grid;
          gap: 20px;
          justify-items: center;
          min-height: 0;
        }

        .phone {
          position: static;
          width: min(300px, 100%);
          order: -1;
        }

        .mini-dash {
          position: static;
          width: min(300px, 100%);
        }

        .stack-card__hit {
          display: none;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .btn:hover {
          transform: none;
        }

        .faq__plus {
          transition: none;
        }

        .reveal-ready [data-reveal] {
          opacity: 1;
          transform: none;
          transition: none;
        }

        .stack-card,
        [data-seg],
        .chat__typing i {
          transition: none;
          animation: none;
        }
      }
    </style>

    <script>
      import { startHeroArt } from '../scripts/hero-art';

      startHeroArt();
    </script>
  </body>
</html>
